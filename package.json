{
  "name": "dominio-globale",
  "version": "1.0.0",
  "private": true,
  "description": "Gioco online di conquista strategica per 2-6 giocatori.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "import:board": "node scripts/import-board-svg.mjs",
    "validate:dice": "node --experimental-strip-types scripts/validate-dice-rules.mjs",
    "validate:objectives": "node scripts/validate-objectives.mjs",
    "check": "npm run validate:objectives && npm run validate:dice && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "next": "16.2.6",
    "pg": "8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "typescript": "5.9.3"
  },
  "type": "module"
}
